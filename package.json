{
	"name": "openagent",
	"version": "0.1.0",
	"type": "module",
	"description": "Your terminal coding assistant",
	"bin": {
		"openagent": "src/index.tsx"
	},
	"scripts": {
		"dev": "bun run src/index.tsx",
		"start": "bun run src/index.tsx",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"format": "biome format --write",
		"test": "bun test",
		"check": "bun run typecheck && bun run lint && bun run test"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "^0.79.9",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@opentui/core": "^0.4.1",
		"@opentui/react": "^0.4.1",
		"playwright": "^1.61.1",
		"react": "^19.0.0",
		"typebox": "^1.1.38"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.1",
		"@types/react": "^19.0.0",
		"lefthook": "^2.1.9",
		"typescript": "^5.7.0"
	}
}
